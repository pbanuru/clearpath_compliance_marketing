{"title":"ClearPath Financial | Personal Loans","finalUrl":"http://127.0.0.1:38893/sites/landing/index.html","size":{"width":1440,"height":2452},"heightTruncated":false,"blocks":[{"text":"ClearPath","x":96,"y":30.5,"width":141.109375,"height":32},{"text":"Personal loans","x":619.59375,"y":38.5,"width":90.0625,"height":16},{"text":"How it works","x":743.65625,"y":38.5,"width":79.875,"height":16},{"text":"FAQs","x":857.53125,"y":38.5,"width":31.828125,"height":16},{"text":"Check your rate","x":1171.828125,"y":24.5,"width":172.171875,"height":44},{"text":"Personal loans. Personal possibilities.","x":96,"y":211.578125,"width":592,"height":12},{"text":"Personal loans for what's next","x":96,"y":246.578125,"width":540,"height":146.15625},{"text":"Fixed rates from 5.99% to 35.99% APR. Loans from $2,000 to $50,000.","x":96,"y":417.734375,"width":480,"height":62.6875},{"text":"Check your rate","x":96,"y":511.421875,"width":205,"height":58},{"text":"Checking your rate won't affect your credit score.","x":96,"y":582.421875,"width":592,"height":18},{"text":"A little clarity. A lot of possibility.","x":846,"y":577,"width":107.390625,"height":36},{"text":"Fixed monthly payments","x":126,"y":746,"width":140.28125,"height":15},{"text":"Funds as soon as the next business day","x":633.046875,"y":746,"width":227.734375,"height":15},{"text":"No prepayment fees","x":1227.53125,"y":746,"width":116.46875,"height":15},{"text":"Give your budget some breathing room","x":137,"y":908.75,"width":241.59375,"height":11},{"text":"Lower your monthly payment","x":137,"y":933.75,"width":382.875,"height":35},{"text":"Pay as little as $150/month.","x":1061.34375,"y":891,"width":241.65625,"height":88.5},{"text":"A clear path forward","x":96,"y":1093.5,"width":241.40625,"height":11},{"text":"How it works","x":96,"y":1116.5,"width":241.40625,"height":51},{"text":"From a first look to your next step, know where you stand.","x":1133.90625,"y":1119.3125,"width":210.09375,"height":44.1875},{"text":"01 Check your rate Tell us a little about your plans and see the options available to you.","x":96,"y":1202.5,"width":384.65625,"height":168.78125},{"text":"02 Choose your loan Review your offer, choose an amount, and complete your application.","x":527.65625,"y":1202.5,"width":384.671875,"height":168.78125},{"text":"03 Move forward After approval and verification, receive your funds and put your plan in motion.","x":959.328125,"y":1202.5,"width":384.65625,"height":168.78125},{"text":"Good questions. Clear answers.","x":96,"y":1505.28125,"width":484.578125,"height":11},{"text":"A little more peace of mind.","x":96,"y":1533.28125,"width":484.578125,"height":92.375},{"text":"Here's what to know as you explore your options.","x":96,"y":1645.65625,"width":280,"height":44.1875},{"text":"You can use a personal loan to consolidate debt, make home improvements, cover a major expense, or fund another eligible personal purpose.","x":665.578125,"y":1537.28125,"width":590,"height":46.78125},{"text":"Checking your rate uses a soft credit inquiry and won't affect your credit score. If you accept an offer and proceed with a full application, a hard credit inquiry may affect your score.","x":665.578125,"y":1656.0625,"width":590,"height":70.171875},{"text":"After approval and completion of required verification, funds may be available as soon as the next business day. Timing also depends on your bank and when you complete the process.","x":665.578125,"y":1798.234375,"width":590,"height":70.171875},{"text":"Yes. You can make extra payments or pay your loan off early with no prepayment fees.","x":665.578125,"y":1940.40625,"width":590,"height":23.390625},{"text":"Your next step starts here","x":96,"y":2106.796875,"width":428,"height":11},{"text":"Make room for what's next.","x":96,"y":2129.796875,"width":428,"height":42},{"text":"Check your rate","x":1137.140625,"y":2110.296875,"width":206.859375,"height":58},{"text":"ClearPath","x":96,"y":2258.796875,"width":119.0625,"height":27},{"text":"A clearer way forward.","x":1226.140625,"y":2265.296875,"width":117.859375,"height":14},{"text":"Your APR depends on credit and other factors. Not all applicants qualify. Loans made by ClearPath Financial, NMLS ID 2468101. Not available in all states.","x":96,"y":2338.796875,"width":1110,"height":22.796875},{"text":"ClearPath Financial, 100 Market Street, Suite 400, Wilmington, DE 19801","x":96,"y":2369.59375,"width":1248,"height":19.796875},{"text":"© 2026 ClearPath Financial. All rights reserved.","x":96,"y":2411.390625,"width":1248,"height":11}],"blocksTruncated":false,"sourceUrl":"http://127.0.0.1:38893/sites/landing/index.html","browserMs":1665,"capturedAt":1793191693493,"screenshot":"evals/cases/addendum/landing.jpg","provenance":{"renderer":"DEV union renderCapture; local Chrome","sourceHashes":{"expo/worker/capturePage.ts":"cbbf83dc165e0e72192f8176a470c7e64fe53f7dbeb5c899a6f142bec2735d70","backend/convex/webpageBlocks.ts":"24de266c4f5de90b470013d2c4049b9ab73f768f6d3a44cac5c5ffabdccdc8f1"},"htmlSha256":"c2b6dd26397a71f016c14a14edb26aff7f1ee994e04dd8c6c6a15bb6f0258076"}}
