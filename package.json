{
  "name": "clearpath_compliance_marketing",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "diagrams": "node scripts/render-diagrams.mjs",
    "dev:web": "npm run web -w @clearpath/expo",
    "dev:backend": "npm run dev -w @clearpath/backend",
    "export:web": "npm run export:web -w @clearpath/expo",
    "deploy:web": "npm exec -w @clearpath/backend -- convex deploy --yes --cmd-url-env-var-name EXPO_PUBLIC_CONVEX_URL --cmd \"npm run export:web -w @clearpath/expo\" && npm exec -w @clearpath/expo -- wrangler deploy",
    "check": "npm run check:lines && npm run check:skills && npm run format:check && npm run typecheck && npm run lint && npm run test:auth && npm run test:assets && npm run test:findings && npm run test:pdf && npm run knip",
    "check:lines": "node scripts/check-file-lines.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "test:auth": "node --experimental-test-module-mocks --test expo/worker/auth.test.mjs",
    "test:pdf": "node --test expo/src/features/review/pdf.test.mjs",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings=0",
    "knip": "knip",
    "fix": "eslint . --fix && prettier --write .",
    "test:findings": "npm run test:findings -w @clearpath/expo",
    "test:assets": "npm run test -w @clearpath/backend",
    "evals": "node evals/run.mjs"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@viz-js/viz": "3.31.0",
    "eslint": "~9.39.5",
    "eslint-config-expo": "^58.0.4",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "workspaces": [
    "expo",
    "backend"
  ],
  "allowScripts": {
    "esbuild@0.27.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "fsevents": false,
    "unrs-resolver": false
  }
}
