digraph clearpath {
  rankdir=LR; compound=true; bgcolor="white"; fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#ECECFF", color="#9370DB", fontname="Helvetica"];
  edge [fontname="Helvetica", color="#555555"];
  browser [label="Browser\nExpo Router web client"];
  cloudflare [label="Cloudflare Workers\nExpo rendering, assets, auth sessions"];
  convex [label="Convex\nOwned reviews, campaigns, policies\nAI jobs and source checks"];
  r2 [label="Cloudflare R2\nPrivate media and webpage captures"];
  chromium [label="Cloudflare Browser Run\nPuppeteer page capture"];
  destination [label="Submitted public page\nRendered marketing content"];
  sources [label="Subscribed rule sources\neCFR, Federal Register, CFPB/FTC\nSaved reference pages and feeds"];
  openai [label="OpenAI\nQuick checks and detailed review\nPolicy drafts and rechecks"];
  assemblyai [label="AssemblyAI\nSpeech transcript and word timings"];
  gemini [label="Gemini\nVideo visual observations"];
  dev [label="Convex development\nSeparate deployment"];
  local [label="Local checkout\nExpo + backend workspaces"];
  github [label="Private GitHub repository"];
  ci [label="GitHub Actions\nChecks and production deployment"];
  codex [label="Codex\nAutomatic PR review"];
  workos [label="WorkOS AuthKit\nHosted sign-in and sessions"];
  browser -> cloudflare [label="page and asset requests"];
  cloudflare -> chromium [label="URL capture request"];
  chromium -> destination [label="render and scroll"];
  chromium -> cloudflare [label="screenshot and positioned text"];
  cloudflare -> browser [label="private capture response"];
  browser -> convex [label="authenticated workspace APIs"];
  convex -> browser [label="reactive state and temporary file URLs"];
  browser -> r2 [label="signed uploads and previews"];
  convex -> r2 [label="verify and read private files"];
  convex -> sources [label="fetch subscribed sources"];
  sources -> convex [label="source text and publications"];
  convex -> openai [label="material or source evidence, rules"];
  openai -> convex [label="estimates, findings and update drafts"];
  convex -> assemblyai [label="signed audio/video URL"];
  assemblyai -> convex [label="transcript and timings"];
  convex -> gemini [label="original video stream"];
  gemini -> convex [label="visual timeline"];
  browser -> workos [label="hosted sign-in"];
  workos -> cloudflare [label="authorization code via browser"];
  cloudflare -> workos [label="code exchange and token refresh"];
  local -> dev [label="convex dev"];
  ci -> convex [label="deploy backend after main checks"];
  ci -> cloudflare [label="deploy production web build"];
  local -> github [label="commits and PRs"];
  github -> ci [label="pushes and PRs"];
  github -> codex [label="ready PRs"];
}
