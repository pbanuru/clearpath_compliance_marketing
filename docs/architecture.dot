digraph clearpath {
  rankdir=LR; compound=true; bgcolor="white"; fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#ECECFF", color="#9370DB", fontname="Helvetica"];
  edge [fontname="Helvetica", color="#555555"];
  browser [label="Browser\nExpo Router web client"];
  cloudflare [label="Cloudflare Workers\nAssets, server rendering, cache"];
  convex [label="Convex production\nAssets, review versions, findings, decisions\nOwnership, events, AI spans and usage"];
  r2 [label="Cloudflare R2\nPrivate originals, posters, video frames\nWebpage screenshots and analysis tiles"];
  chromium [label="Browser Run\nPuppeteer / BROWSER binding\n1440px screenshot + positioned DOM text"];
  destination [label="Submitted public HTTP(S) page\nClient-rendered content + lazy loading"];
  openai [label="OpenAI API\nMultimodal first read"];
  assemblyai [label="AssemblyAI US API\nTimestamped audio/video transcription"];
  gemini [label="Gemini API\nReusable video visual timelines"];
  dev [label="Convex development\nSeparate deployment"];
  local [label="Local checkout\nExpo + backend workspaces"];
  github [label="Private GitHub repository"];
  ci [label="GitHub Actions\nChecks and production deployment"];
  codex [label="Codex\nAutomatic PR review"];
  workos [label="WorkOS AuthKit\nHosted sign-in and sessions"];
  browser -> cloudflare [label="page and asset requests"];
  cloudflare -> chromium [label="signed-in POST /api/capture"];
  chromium -> destination [label="fresh browser session, render and scroll"];
  chromium -> cloudflare [label="JPEG, text boxes, browser duration"];
  cloudflare -> browser [label="private capture response"];
  browser -> convex [label="authenticated assets, review queue, triage"];
  browser -> r2 [label="direct file uploads, temporary preview URLs"];
  convex -> r2 [label="sign URLs, verify object metadata"];
  convex -> openai [label="private media + webpage tiles/text + context\nstrict review output; measured quote anchors"];
  convex -> assemblyai [label="signed original audio/video GET URL"];
  convex -> gemini [label="stream original video, structured timeline"];
  gemini -> convex [label="timed text, character context, visuals, usage"];
  assemblyai -> convex [label="word timings, transcript, usage"];
  openai -> convex [label="findings and usage"];
  browser -> workos [label="hosted sign-in"];
  workos -> cloudflare [label="authorization code via browser"];
  cloudflare -> workos [label="code exchange and token refresh"];
  local -> dev [label="convex dev"];
  ci -> convex [label="deploy backend after main checks"];
  ci -> cloudflare [label="deploy production web build"];
  local -> github [label="commits and PRs"];
  github -> ci [label="pushes and PRs"];
  github -> codex [label="ready PRs"];
}
